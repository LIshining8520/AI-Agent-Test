# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）。
# 浏览器端通过 import.meta.env 读取，只有 VITE_ 前缀的变量会暴露给前端。
#
# ── 线上部署时的区别（重要）──────────────────────────────────
# 生产构建若存在 VITE_DEEPSEEK_API_KEY，Key 会被**明文内联**进 dist/assets/*.js。
# 线上请改配服务端变量 DEEPSEEK_API_KEY（无 VITE_ 前缀），前端会自动改走
# 同源代理 /api/llm（见 api/llm/chat/completions.ts 与 README「部署到线上」）。
# 只有需要强制指定时才动这个开关：1=强制走代理，0=强制直连。
# VITE_LLM_PROXY=1

# OpenAI
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini

# DeepSeek（OpenAI 兼容协议）
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 弃用，请用 deepseek-v4-flash / deepseek-v4-pro
VITE_DEEPSEEK_MODEL=deepseek-v4-flash

# 全局默认模型（优先级低于 VITE_OPENAI_MODEL/VITE_DEEPSEEK_MODEL）
VITE_DEFAULT_CHAT_MODEL=

# 旅游多 Agent（课 9-12）· 第二供应商（可选，用来演示故障转移链）
# 链顺序：deepseek → backup → openai，前一个失败自动降级到下一个；
# 没有任何 Key 时三个执行者全部走主数据兜底，页面照常可用。
VITE_LLM_BACKUP_NAME=backup
VITE_LLM_BACKUP_API_KEY=
VITE_LLM_BACKUP_BASE_URL=
VITE_LLM_BACKUP_MODEL=

# Qdrant（RAG 向量库；浏览器端只能读到 VITE_ 前缀的变量）
VITE_QDRANT_URL=http://localhost:6333
VITE_QDRANT_API_KEY=
VITE_QDRANT_COLLECTION=ai_agent_kb

# Embedding：openai / hash（本地零依赖）/ auto（有 Key 用 openai，否则 hash）
VITE_EMBEDDING_PROVIDER=auto
VITE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
